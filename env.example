# Venice (enrich / verify) — load from vault in ops; never commit real keys
VENICE_API_KEY=

# SQLite (shared by legacy Python and future PHP)
DATABASE_NAME=doj_cases.db
# DATABASE_PATH=/path/to/doj_cases.db

# Legacy Flask
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FILE_SERVER_PORT=8000
FILE_SERVER_DIRECTORY=.

# CourtListener (courtlistener-sdk) — vault: ~/.ssh/courtlistener-api.pass
COURTLISTENER_API_TOKEN=
COURTLISTENER_API_BASE=https://www.courtlistener.com/api/rest/v4
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4

# Admin bootstrap (AD-S4) — prefer ~/.ssh/project1960-admin.pass; never commit values
# P1960_ADMIN_USERNAME=
# P1960_ADMIN_EMAIL=
# P1960_ADMIN_PASSWORD=
# P1960_ADMIN_ROLE=operator
